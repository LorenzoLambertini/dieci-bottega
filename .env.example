# ─── Dieci Bottega — Environment Variables ───────────────────────────
# Copy this file to .env.local and fill in the values.
# NEVER commit .env.local to git.

# ── Site URL (used in sitemap, OG meta) ──────────────────────────────
NEXT_PUBLIC_SITE_URL=https://diecibottega.it

# ── Contact form — Resend (required for real email delivery) ─────────
# Get your API key at https://resend.com
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Email address that receives contact form submissions
CONTACT_EMAIL=ciao@diecibottega.it

# ── Supabase — CRM backend ───────────────────────────────────────────
# Get these from https://app.supabase.com → your project → Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://voyhwqqubcathcvjatyk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ── Analytics (optional) ─────────────────────────────────────────────
# NEXT_PUBLIC_PLAUSIBLE_DOMAIN=diecibottega.it
# NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX

# ── Supabase service role (SOLO server: webhook, AI engine, appuntamenti) ──
SUPABASE_SERVICE_ROLE_KEY=
# Email del team per notifiche (già usata da /api/lead)
TEAM_EMAILS=

# ════════════════════════════════════════════════════════════════════
#  Social AI — vedi SOCIAL_AI_SETUP.md
# ════════════════════════════════════════════════════════════════════

# ── Claude (Anthropic) — unico costo AI ──────────────────────────────
ANTHROPIC_API_KEY=
# Modello (modificabile anche da /crm/settings/social-ai). Es: claude-opus-5,
# claude-sonnet-5 (più economico), claude-haiku-4-5 (il più economico)
ANTHROPIC_MODEL=claude-opus-5

# ── Cifratura token social (32 byte, hex o base64) ───────────────────
# Genera con: openssl rand -hex 32
SOCIAL_TOKEN_ENCRYPTION_KEY=

# ── Meta (Instagram + Facebook) ──────────────────────────────────────
META_APP_ID=
META_APP_SECRET=
# Stringa casuale scelta da te, da inserire anche nella Meta App → Webhooks
META_VERIFY_TOKEN=
# Opzionale (default v25.0)
# META_GRAPH_VERSION=v25.0

# ── LinkedIn (Community Management API — richiede approvazione) ──────
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# Opzionale (formato YYYYMM, default 202606)
# LINKEDIN_API_VERSION=202606

# ── TikTok (Login Kit + webhook lead — richiede approvazione) ────────
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=

# ── Vercel Cron (retry controllati) ──────────────────────────────────
CRON_SECRET=
